---
const navigation = [
  { name: 'Home', href: '/' },
  { name: 'Projects', href: '/project' },
  { name: 'Blog', href: '/blog' },
  { name: 'Store', href: 'https://store.rxliuli.com/', external: true },
]

const currentPath = Astro.url.pathname
const isActive = (href: string) => (href === '/' ? currentPath === '/' : currentPath.startsWith(href))
---

<header class="mx-auto flex w-full max-w-6xl flex-wrap items-center justify-between gap-4 px-4 py-4 sm:px-6">
  <a href="/" class="font-mono text-sm font-medium transition-colors hover:text-primary">
    ~/rxliuli<span class="text-primary">_</span>
  </a>

  <nav class="flex flex-wrap gap-1 rounded-xl border border-border bg-card p-1 text-sm font-medium">
    {
      navigation.map((item) => (
        <a
          href={item.href}
          {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          aria-current={!item.external && isActive(item.href) ? 'page' : undefined}
          class:list={[
            'rounded-lg px-3.5 py-2 transition-colors hover:text-primary',
            !item.external && isActive(item.href) && 'bg-border',
          ]}
        >
          {item.name}
          {item.external && ' ↗'}
        </a>
      ))
    }
  </nav>
</header>
