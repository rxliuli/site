---
const links = [
  { name: 'GitHub', href: 'https://github.com/rxliuli' },
  { name: 'Discord', href: 'https://discord.gg/gFhKUthc88' },
  { name: 'Sponsor', href: 'https://github.com/sponsors/rxliuli' },
]
---

<footer class="mx-auto mt-16 w-full max-w-6xl px-4 sm:px-6">
  <div
    class="flex flex-col items-start justify-between gap-4 border-t border-border py-8 font-mono text-xs text-muted-foreground sm:flex-row sm:items-center"
  >
    <p>© {new Date().getFullYear()} rxliuli</p>
    <div class="flex gap-5">
      {
        links.map((link) => (
          <a href={link.href} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-primary">
            {link.name}
          </a>
        ))
      }
    </div>
  </div>
</footer>
