---
import Layout from '../layouts/Layout.astro'
import { getAllProjects } from '../data/projects'
import { getAllBlogPosts } from '../data/blogs'
import { countByKind, getMonogram, getPlatforms, getProjectKind } from '../data/project-kinds'
import type { ProjectMeta } from '../types/project'
import { sortBy } from 'es-toolkit'
import dayjs from 'dayjs'

const allProjects = getAllProjects()
const kinds = countByKind(allProjects)

// 按发布时间倒序，用于挑选“最近的作品”
const byNewest = sortBy(allProjects, [(it) => -new Date(it.created ?? it.updated).getTime()])
const newestOf = (type: ProjectMeta['type'], exclude: ProjectMeta[] = []) =>
  byNewest.find((it) => it.type === type && !exclude.includes(it))

// 大卡片：最新的一个浏览器扩展 + 最新的一个 App
const featured = [newestOf('Browser Extension'), newestOf('App')].filter((it): it is ProjectMeta => !!it)
// 小卡片：每种类型各取一个最新的（排除已在大卡片中出现的）
const more = kinds
  .map((kind) => newestOf(kind.type, featured))
  .filter((it): it is ProjectMeta => !!it)
  .slice(0, 4)

// 所有项目覆盖到的运行平台
const platformOrder = ['chrome', 'firefox', 'edge', 'safari', 'macos', 'app store', 'vscode', 'android', 'windows', 'linux', 'web']
const platformLabels: Record<string, string> = {
  chrome: 'Chrome',
  firefox: 'Firefox',
  edge: 'Edge',
  safari: 'Safari',
  macos: 'macOS',
  'app store': 'App Store',
  vscode: 'VSCode',
  android: 'Android',
  windows: 'Windows',
  linux: 'Linux',
  web: 'Web',
}
const usedPlatforms = new Set(allProjects.flatMap(getPlatforms))
const platforms = platformOrder.filter((it) => usedPlatforms.has(it)).map((it) => platformLabels[it])

const posts = sortBy(await getAllBlogPosts(), [(it) => -new Date(it.date).getTime()])
const [latestPost, ...restPosts] = posts
const recentPosts = restPosts.slice(0, 4)

const socials = [
  { name: 'GitHub', href: 'https://github.com/rxliuli' },
  { name: 'Discord', href: 'https://discord.gg/gFhKUthc88' },
  { name: 'Sponsor ♥', href: 'https://github.com/sponsors/rxliuli' },
]

const tile = 'rounded-3xl border border-border bg-card'
---

<Layout title="rxliuli">
  <div class="flex flex-wrap gap-4 pt-6">
    <!-- 自我介绍 -->
    <section class:list={[tile, 'flex min-h-[340px] flex-[2_1_560px] flex-col justify-between gap-8 p-7 sm:p-9']}>
      <span class="font-mono text-sm text-muted-foreground">$ whoami</span>
      <div class="flex flex-col gap-4">
        <h1 class="font-display text-[clamp(2.25rem,5.4vw,4rem)] leading-[1.02] font-bold tracking-tight">
          rxliuli. I build small tools for the browser, the Mac, and the web.
        </h1>
        <p class="max-w-xl text-[17px] leading-relaxed text-subtle-foreground">
          I like to create interesting things, using programming and writing as tools.
        </p>
      </div>
      <div class="flex flex-wrap gap-2.5">
        {
          socials.map((it) => (
            <a
              href={it.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex h-11 items-center rounded-xl border border-border-strong px-4 text-sm font-medium transition-colors hover:border-primary hover:text-primary"
            >
              {it.name}
            </a>
          ))
        }
      </div>
    </section>

    <div class="flex flex-[1_1_300px] flex-col gap-4">
      <!-- 按类型统计 -->
      <div class="flex flex-1 flex-col gap-4 rounded-3xl bg-primary p-7 text-primary-foreground">
        <div class="flex items-baseline gap-3">
          <span class="font-display text-7xl leading-[0.9] font-bold tracking-tighter">{allProjects.length}</span>
          <span class="font-mono text-sm">tools shipped</span>
        </div>
        <div class="flex flex-col">
          {
            kinds.map((kind) => (
              <a
                href={`/project?type=${kind.slug}`}
                class="flex items-center justify-between gap-3 border-t border-primary-foreground/20 py-2.5 text-[15px] font-medium hover:underline"
              >
                <span>{kind.label}</span>
                <span class="font-mono text-sm">{kind.count} →</span>
              </a>
            ))
          }
        </div>
      </div>

      <!-- 运行平台 -->
      <div class:list={[tile, 'flex flex-col gap-3.5 px-7 py-6']}>
        <span class="font-mono text-sm text-muted-foreground">runs on</span>
        <div class="flex flex-wrap gap-2">
          {platforms.map((it) => <span class="rounded-full bg-secondary px-3 py-1.5 text-[13px] font-medium">{it}</span>)}
        </div>
      </div>
    </div>

    <!-- 重点项目 -->
    {
      featured.map((project) => (
        <a
          href={`/project/${project.slug}`}
          class:list={[tile, 'group flex flex-[1.4_1_340px] flex-col gap-5 p-7 transition-colors hover:border-border-strong sm:p-8']}
        >
          <div class="flex flex-wrap items-center justify-between gap-3">
            <span class="rounded-lg border border-primary px-2.5 py-1 font-mono text-xs text-primary">
              {getProjectKind(project.type).label.replace(/s$/, '').toLowerCase()}
            </span>
            <span class="font-mono text-sm text-muted-foreground">latest</span>
          </div>
          <div class="flex flex-col gap-2.5">
            <h2 class="font-display text-4xl font-bold tracking-tight transition-colors group-hover:text-primary">
              {project.title}
            </h2>
            <p class="leading-relaxed text-subtle-foreground">{project.description}</p>
          </div>
          <span class="mt-auto font-mono text-xs text-muted-foreground">{getPlatforms(project).join(' · ')}</span>
        </a>
      ))
    }

    <!-- 最新文章 -->
    {
      latestPost && (
        <a
          href={`/blog/${latestPost.slug}`}
          class:list={[tile, 'group flex flex-[1_1_280px] flex-col justify-between gap-6 p-7 transition-colors hover:border-border-strong']}
        >
          <span class="font-mono text-sm text-muted-foreground">
            latest post · {dayjs(latestPost.date).format('MMM D')}
          </span>
          <span class="font-display text-2xl leading-tight font-semibold">{latestPost.title}</span>
          <span class="text-sm font-medium text-primary">Read →</span>
        </a>
      )
    }

    <!-- 各类型的最新项目 -->
    {
      more.map((project) => (
        <a
          href={`/project/${project.slug}`}
          class="group flex flex-[1_1_240px] flex-col gap-3.5 rounded-[20px] border border-border bg-card p-6 transition-colors hover:border-border-strong"
        >
          <div class="flex items-center justify-between gap-2">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-secondary font-mono text-sm font-medium text-primary">
              {getMonogram(project.title)}
            </span>
            <span class="rounded-md bg-secondary px-2 py-1 font-mono text-[11px] text-subtle-foreground">
              {getProjectKind(project.type).short}
            </span>
          </div>
          <span class="font-display text-xl font-semibold transition-colors group-hover:text-primary">{project.title}</span>
          <span class="line-clamp-3 text-sm leading-relaxed text-subtle-foreground">{project.description}</span>
          <span class="mt-auto font-mono text-xs text-muted-foreground">{getPlatforms(project).join(' · ')}</span>
        </a>
      ))
    }

    <!-- 文章列表 -->
    <section class:list={[tile, 'flex flex-[1_1_100%] flex-col gap-2 p-7 sm:p-8']}>
      <div class="flex flex-wrap items-center justify-between gap-3 pb-2">
        <h2 class="font-display text-2xl font-semibold">Writing</h2>
        <a href="/blog" class="text-sm font-medium text-primary hover:underline">All {posts.length} posts →</a>
      </div>
      {
        recentPosts.map((post) => (
          <a
            href={`/blog/${post.slug}`}
            class="flex items-baseline justify-between gap-6 border-t border-border py-3.5 transition-colors hover:text-primary"
          >
            <span class="leading-snug">{post.title}</span>
            <span class="font-mono text-xs whitespace-nowrap text-muted-foreground">
              {dayjs(post.date).format('YYYY-MM-DD')}
            </span>
          </a>
        ))
      }
    </section>
  </div>
</Layout>
