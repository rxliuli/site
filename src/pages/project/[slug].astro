---
import Layout from '../../layouts/Layout.astro'
import ProjectMiniCard from '../../components/ProjectMiniCard.astro'
import { getAllProjects } from '../../data/projects'
import type { ProjectMeta } from '../../types/project'
import { getPlatforms, getProjectKind } from '../../data/project-kinds'
import { sortBy } from 'es-toolkit'
import dayjs from 'dayjs'

export async function getStaticPaths() {
  const projects = await getAllProjects()
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project, projects },
  }))
}

interface Props {
  project: ProjectMeta
  projects: ProjectMeta[]
}

const { project: meta, projects } = Astro.props
const kind = getProjectKind(meta.type)

// 结构化内容里的行内格式：`code`、**bold** 与 [text](url)
const inline = (text: string) =>
  text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/`([^`]+)`/g, '<code class="rounded-md bg-secondary px-1.5 py-0.5 font-mono text-[0.9em] text-foreground">$1</code>')
    .replace(/\*\*([^*]+)\*\*/g, '<strong class="font-semibold text-foreground">$1</strong>')
    .replace(
      /\[([^\]]+)\]\(([^)\s]+)\)/g,
      (_, label, href) =>
        `<a href="${href}"${href.startsWith('/') ? '' : ' target="_blank" rel="noopener noreferrer"'} class="text-primary underline underline-offset-2">${label}</a>`,
    )

// 商店链接是主要操作，其余（源码、社区、文档）降级为文字链接
const storeLinks = meta.links?.filter((link) => link.type === 'store') ?? []
const otherLinks = meta.links?.filter((link) => link.type !== 'store') ?? []
// 没有商店链接的项目（如网站），把第一个其他链接提升为主按钮
const primaryLinks = storeLinks.length > 0 ? storeLinks : otherLinks.slice(0, 1)
const secondaryLinks = storeLinks.length > 0 ? otherLinks : otherLinks.slice(1)
const buttonLabel = (name: string) => {
  if (storeLinks.length === 0) return `Open ${name}`
  return name === 'Homebrew' ? 'Install via Homebrew' : `Get for ${name}`
}

const facts = [
  { label: 'runs on', value: getPlatforms(meta).join(' · ') },
  { label: 'released', value: meta.created && dayjs(meta.created).format('YYYY-MM-DD') },
  { label: 'updated', value: dayjs(meta.updated).format('YYYY-MM-DD') },
  { label: 'license', value: meta.license },
].filter((it) => !!it.value)

// 支持渠道由链接推导，不在内容里手写
const github = meta.links?.find((link) => link.icon === 'github' && link.url.includes('github.com/rxliuli/'))
const discord = meta.links?.find((link) => link.icon === 'discord')
const supportLinks = [
  github && { name: 'GitHub Issues', url: `${github.url.replace(/\/$/, '')}/issues` },
  discord && { name: 'Discord', url: discord.url },
].filter((it): it is { name: string; url: string } => !!it)

// 只展示内容里指定的截图，previewImage 可能是宣传图，不作为回退
const screenshot = meta.screenshot

// 同类型的其他项目，按发布时间倒序
// 首字母小写，但保留 VSCode 这类缩写的大小写
const kindName = /^[A-Z][a-z]/.test(kind.label) ? kind.label[0].toLowerCase() + kind.label.slice(1) : kind.label
const sameKind = projects.filter((it) => it.type === meta.type && it.slug !== meta.slug)
const related = sortBy(sameKind, [(it) => -new Date(it.created ?? it.updated).getTime()]).slice(0, 3)

const tile = 'rounded-3xl border border-border bg-card'
const buttonBase =
  'store-link inline-flex h-11 items-center gap-2 rounded-xl border px-4 text-sm font-medium transition-colors'
const buttonIdle = 'border-border-strong hover:border-primary hover:text-primary'
const buttonActive = 'border-primary bg-primary text-primary-foreground hover:bg-primary/90'
const sectionTitle = 'font-display text-3xl font-bold tracking-tight'
const sectionIntro = 'max-w-2xl leading-relaxed text-subtle-foreground'
const note = 'max-w-3xl text-sm leading-relaxed text-muted-foreground'
---

<Layout title={`${meta.title} - rxliuli`} description={meta.description} image={meta.previewImage} type="website">
  <div class="flex flex-wrap gap-4 pt-6">
    <!-- 标题与安装 -->
    <section class:list={[tile, 'flex flex-[2_1_560px] flex-col gap-8 p-7 sm:p-9']}>
      <div class="flex flex-wrap items-center justify-between gap-3">
        <span class="font-mono text-sm text-muted-foreground">
          <a href="/project" class="transition-colors hover:text-primary">~/projects</a>/{meta.slug}
        </span>
        <a
          href={`/project?type=${kind.slug}`}
          class="rounded-lg border border-primary px-2.5 py-1 font-mono text-xs text-primary transition-colors hover:bg-primary hover:text-primary-foreground"
        >
          {kind.label.replace(/s$/, '').toLowerCase()}
        </a>
      </div>
      <div class="flex flex-col gap-4">
        {meta.icon && <img src={meta.icon} alt="" width="64" height="64" class="h-16 w-16 rounded-2xl" />}
        <h1 class="font-display text-[clamp(2.25rem,5.4vw,3.75rem)] leading-[1.02] font-bold tracking-tight">
          {meta.title}
        </h1>
        <p class="font-display text-[clamp(1.25rem,2.4vw,1.6rem)] leading-snug font-medium">{meta.tagline}</p>
        <p class="max-w-2xl text-[17px] leading-relaxed text-subtle-foreground" set:html={inline(meta.intro)} />
      </div>
      <div class="mt-auto flex flex-col gap-4">
        {
          primaryLinks.length > 0 && (
            <div class="flex flex-wrap gap-2.5" data-store-links>
              {primaryLinks.map((link, i) => (
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-icon={link.icon}
                  class:list={[buttonBase, i === 0 ? buttonActive : buttonIdle]}
                >
                  {buttonLabel(link.name)}
                  <span aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          )
        }
        {
          meta.install?.command && (
            <div class="flex max-w-xl items-center justify-between gap-3 rounded-xl border border-border bg-background py-1.5 pr-1.5 pl-4">
              <code class="overflow-x-auto font-mono text-sm whitespace-nowrap text-subtle-foreground">
                <span class="text-muted-foreground select-none">$ </span>
                {meta.install.command}
              </code>
              <button
                type="button"
                data-copy={meta.install.command}
                class="h-8 shrink-0 rounded-lg border border-border-strong px-3 font-mono text-xs transition-colors hover:border-primary hover:text-primary"
              >
                copy
              </button>
            </div>
          )
        }
        {meta.install?.note && <p class="font-mono text-xs leading-relaxed text-muted-foreground">{meta.install.note}</p>}
        {
          secondaryLinks.length > 0 && (
            <div class="flex flex-wrap gap-x-5 gap-y-2 font-mono text-sm text-muted-foreground">
              {secondaryLinks.map((link) => (
                <a href={link.url} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-primary">
                  {link.name} ↗
                </a>
              ))}
            </div>
          )
        }
      </div>
    </section>

    <!-- 项目信息 -->
    <aside class:list={[tile, 'flex flex-[1_1_280px] flex-col gap-1 px-7 py-6']}>
      {
        facts.map((fact) => (
          <div class="flex items-baseline justify-between gap-4 border-b border-border py-3">
            <span class="font-mono text-sm text-muted-foreground">{fact.label}</span>
            <span class="text-right text-[15px] font-medium">{fact.value}</span>
          </div>
        ))
      }
      {
        meta.tags && meta.tags.length > 0 && (
          <div class="flex flex-col gap-3 pt-4">
            <span class="font-mono text-sm text-muted-foreground">tags</span>
            <div class="flex flex-wrap gap-2">
              {meta.tags.map((tag) => (
                <span class="rounded-full bg-secondary px-3 py-1.5 text-[13px] font-medium">{tag}</span>
              ))}
            </div>
          </div>
        )
      }
    </aside>

    <!-- 截图 -->
    {
      screenshot && (
        <div class:list={[tile, 'flex-[1_1_100%] overflow-hidden']}>
          <img src={screenshot.src} alt={screenshot.alt} class="h-auto w-full" />
        </div>
      )
    }

    <!-- 结构化内容 -->
    {
      meta.blocks.map((block) => (
        <section class="flex min-w-0 flex-[1_1_100%] flex-col gap-6 pt-12">
          <div class="flex flex-col gap-3">
            <h2 class={sectionTitle}>{block.title}</h2>
            {block.intro && <p class={sectionIntro} set:html={inline(block.intro)} />}
          </div>

          <div class:list={['flex min-w-0 flex-col gap-6', block.image && 'lg:grid lg:grid-cols-2 lg:items-start lg:gap-4']}>
            <div class="flex min-w-0 flex-col gap-6">
              {block.type === 'features' && (
                <div class="grid gap-4 md:grid-cols-2 md:[&>:last-child:nth-child(odd)]:col-span-2">
                  {block.items.map((item) => (
                    <div class="flex flex-col gap-2.5 rounded-[20px] border border-border bg-card p-6">
                      <h3 class="font-display text-lg font-semibold">{item.title}</h3>
                      <p class="text-[15px] leading-relaxed text-subtle-foreground" set:html={inline(item.body)} />
                    </div>
                  ))}
                </div>
              )}

              {block.type === 'list' && (
                <ul class:list={[tile, 'flex flex-col px-7 py-3']}>
                  {block.items.map((item) => (
                    <li class="flex gap-4 border-b border-border py-4 last:border-b-0">
                      <span class="font-mono text-primary" aria-hidden="true">
                        →
                      </span>
                      <p class="leading-relaxed text-subtle-foreground">
                        <strong class="font-semibold text-foreground" set:html={inline(item.title)} />{' '}
                        <span set:html={inline(item.body)} />
                      </p>
                    </li>
                  ))}
                </ul>
              )}

              {block.type === 'steps' && (
                <ol class:list={[tile, 'flex flex-col gap-5 p-7']}>
                  {block.items.map((step, i) => (
                    <li class="flex items-baseline gap-4">
                      <span class="flex h-8 w-8 shrink-0 items-center justify-center self-start rounded-lg bg-secondary font-mono text-sm text-primary">
                        {i + 1}
                      </span>
                      <p class="pt-1 leading-relaxed text-subtle-foreground" set:html={inline(step)} />
                    </li>
                  ))}
                </ol>
              )}

              {block.type === 'code' && (
                <pre
                  data-no-copy
                  class:list={[
                    tile,
                    'overflow-x-auto p-7 font-mono leading-relaxed text-subtle-foreground',
                    // 与配图并排时栏宽减半，缩小字号让目录树完整显示
                    block.image ? 'text-sm lg:text-xs' : 'text-sm',
                  ]}
                >{block.code.trimEnd()}</pre>
              )}

              {'note' in block && block.note && <p class={note} set:html={inline(block.note)} />}
            </div>
            {block.image && (
              <img
                src={block.image.src}
                alt={block.image.alt}
                loading="lazy"
                class="h-auto w-full rounded-3xl border border-border"
              />
            )}
          </div>
        </section>
      ))
    }

    <!-- 隐私与支持 -->
    <div class="flex flex-[1_1_100%] flex-wrap gap-4 pt-12">
      <section class:list={[tile, 'flex flex-[2_1_480px] flex-col gap-4 p-7 sm:p-9']}>
        <span class="font-mono text-sm text-muted-foreground">privacy</span>
        {meta.privacy.map((paragraph) => (
          <p class="max-w-2xl text-[17px] leading-relaxed text-subtle-foreground" set:html={inline(paragraph)} />
        ))}
      </section>
      {supportLinks.length > 0 && (
        <section class:list={[tile, 'flex flex-[1_1_280px] flex-col gap-4 p-7 sm:p-9']}>
          <span class="font-mono text-sm text-muted-foreground">support</span>
          <p class="leading-relaxed text-subtle-foreground">Found a bug or want a feature? Open an issue or come say hi.</p>
          <div class="mt-auto flex flex-wrap gap-2.5">
            {supportLinks.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex h-11 items-center rounded-xl border border-border-strong px-4 text-sm font-medium transition-colors hover:border-primary hover:text-primary"
              >
                {link.name} ↗
              </a>
            ))}
          </div>
        </section>
      )}
    </div>

    <!-- 同类项目 -->
    {
      related.length > 0 && (
        <>
          <div class="flex flex-[1_1_100%] flex-wrap items-baseline justify-between gap-3 pt-12">
            <h2 class="font-display text-2xl font-semibold">More {kindName}</h2>
            <a href={`/project?type=${kind.slug}`} class="text-sm font-medium text-primary hover:underline">
              All {sameKind.length + 1} →
            </a>
          </div>
          {related.map((it) => (
            <ProjectMiniCard project={it} />
          ))}
        </>
      )
    }
  </div>

  <script is:inline define:vars={{ buttonIdle, buttonActive }}>
    // 把与当前浏览器/系统匹配的商店链接设为主按钮；同步执行以避免闪动
    ;(() => {
      const ua = navigator.userAgent
      const isApple = /Macintosh|iPhone|iPad/.test(ua)
      const candidates = /Edg\//.test(ua)
        ? ['edge', 'chrome']
        : /Firefox\//.test(ua)
          ? ['firefox']
          : /Chrome\//.test(ua)
            ? ['chrome']
            : /Safari\//.test(ua)
              ? ['safari', 'appstore', 'macos']
              : []
      if (isApple) candidates.push('macos', 'appstore')
      if (/Windows/.test(ua)) candidates.push('windows')
      if (/Android/.test(ua)) candidates.push('android')
      if (/Linux/.test(ua) && !/Android/.test(ua)) candidates.push('linux')

      const links = [...document.querySelectorAll('[data-store-links] .store-link')]
      const match = candidates.map((icon) => links.find((it) => it.dataset.icon === icon)).find(Boolean)
      if (!match || match === links[0]) return
      const toggle = (el, from, to) => {
        el.classList.remove(...from.split(' '))
        el.classList.add(...to.split(' '))
      }
      toggle(links[0], buttonActive, buttonIdle)
      toggle(match, buttonIdle, buttonActive)
      match.parentElement.prepend(match)
    })()
  </script>

  <script>
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copy ?? '')
          button.textContent = 'copied'
          setTimeout(() => (button.textContent = 'copy'), 1500)
        } catch (err) {
          console.error('Failed to copy:', err)
        }
      })
    })
  </script>
</Layout>
