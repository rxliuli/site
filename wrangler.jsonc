{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "homepage",
  "compatibility_date": "2025-11-25",
  "assets": {
    "directory": "./dist",
  },
  "workers_dev": false,
  "routes": [
    {
      "custom_domain": true,
      "pattern": "rxliuli.com",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
